{
  "name": "neobee-school",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present dev",
    "dev:web": "pnpm --filter @neobee/web dev",
    "dev:mobile": "pnpm --filter @neobee/mobile start",
    "start:web": "pnpm --filter @neobee/web start",
    "start:mobile": "pnpm --filter @neobee/mobile start",
    "build": "pnpm --recursive --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
  }
}
